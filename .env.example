# ─────────────────────────────────────────────────────────────────────────────
#  Istifadah Ilmiyah — environment template
#  Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
#
#  THE ONE RULE:
#    NEXT_PUBLIC_*  ->  compiled into the JavaScript sent to every browser.
#    Everything else ->  server-side only, never leaves the machine.
#
#  A secret with a NEXT_PUBLIC_ prefix is a published secret.
# ─────────────────────────────────────────────────────────────────────────────


# ── PUBLIC — safe in the browser ─────────────────────────────────────────────
# These are meant to be visible. The publishable key is useless without a valid
# user session, because Row Level Security does the actual enforcement.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Canonical site origin. Used for CSP, auth redirects and export links.
#   dev     -> http://localhost:3000
#   Vercel  -> https://your-project.vercel.app
#   server  -> https://hub.yourdomain.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── SECRET — server only. NEVER prefix any of these with NEXT_PUBLIC_ ────────
# The Supabase secret key BYPASSES Row Level Security completely. Exposing it
# hands over every department's financial data to anyone who opens DevTools.
# It belongs in: Vercel project env vars (not exposed to browser), or machine
# env vars / the NSSM service definition on the Windows Server.

SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Anthropic API key. Used by Route Handlers and the worker only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Postgres connection string. ONLY for migrations, seeding and pg_dump —
# the application never opens a database connection (see MASTER-PLAN §4.5).
# Direct connection is IPv6; if your ISP is IPv4-only use the session pooler:
#   postgresql://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:xxxxxxxx@db.xxxxxxxxxxxx.supabase.co:5432/postgres


# ── OBSERVABILITY ────────────────────────────────────────────────────────────
# The DSN is public by design (it only accepts writes) — the auth token is not.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Needed alongside SENTRY_AUTH_TOKEN for next.config.ts's withSentryConfig to
# upload source maps at build/deploy time — the Sentry webpack plugin reads
# these two from the environment automatically, no code change needed. Find
# both in the Sentry project's Settings -> General page (org slug is in the URL).
SENTRY_ORG=
SENTRY_PROJECT=


# ── RUNTIME ──────────────────────────────────────────────────────────────────
# 'vercel' | 'server'  — the ONLY place host differences may be branched on.
DEPLOY_TARGET=vercel

# Report-only while tuning the Content Security Policy; flip to false to enforce.
CSP_REPORT_ONLY=true

# Worker identity, for job_queue.locked_by. Any stable string per instance.
WORKER_ID=local-dev

# Bounded-run controls for worker/index.ts. Leave BOTH unset for a persistent
# worker (`npm run worker`, or the Windows Service on cutover) — it then loops
# forever. .github/workflows/worker.yml sets both so the same loop drains the
# queue once and exits, as a one-shot CI job. See
# docs/job-worker-github-actions.md.
# WORKER_EXIT_WHEN_IDLE=true
# WORKER_MAX_RUNTIME_MS=600000

# Domain used to derive Supabase Auth's internal login email from an ITS
# number (<its_number>@this-domain) — never resolves on the public internet,
# never sent to anyone. See lib/auth/its.ts.
ITS_LOGIN_EMAIL_DOMAIN=members.istifadah.internal

# The organization's own GSTIN. Set this so OCR extraction knows to exclude
# it from vendor_gstin — without it, a vendor invoice that also prints the
# org's own GSTIN as the recipient can get misread as the vendor's GSTIN.
# Optional; leave blank to skip this exclusion. See lib/claude-client.ts and
# lib/jobs/handlers/extract.ts.
COMMUNITY_GSTIN=

# The organization's canonical name, used to fuzzy-match against the
# recipient/"Bill To" block on a GST bill (plan §12 recipient-compliance
# check). Optional; leave blank to skip the buyer-name half of that check.
COMMUNITY_NAME=

# Whether a low-confidence or non-Latin-script Haiku extraction may
# automatically re-run on Sonnet. Default false — the escalation rule triggers
# on `contains_non_latin_script`, which is true for most bills in this corpus,
# so leaving it on ran nearly every document through both models. Haiku runs
# alone until its output has been reviewed on real documents. Set to `true` to
# restore the automatic second pass. The manual "Re-extract with Sonnet" button
# on the review screen works either way.
OCR_AUTO_ESCALATION=false

# Whether the queue-driven initial extraction submits to Anthropic's Batch API
# (50% cheaper, up to 24h turnaround) instead of calling the synchronous
# Messages API in-process. Default false. The manual "Re-extract with Sonnet"
# button and the accuracy harness (test/score.ts) always stay synchronous
# regardless of this flag. See lib/jobs/handlers/extract.ts and
# lib/jobs/handlers/batch-poll.ts (plan.md Phase 3 I16).
OCR_USE_BATCH_API=false

# Whether /api/documents/ingest runs extraction inside the upload request.
# Default false (see lib/env.server.ts's comment for the full history): the
# job queue is drained out-of-process by worker/index.ts running as a GitHub
# Actions job (.github/workflows/worker.yml), so this only needs to be true if
# nothing else drives the queue. Leave/set it true ONLY on a plan tier where
# maxDuration=60 is actually honored (Vercel Pro+ or Fluid compute) -- on
# Hobby, the platform kills the function at 10s regardless, so inline
# extraction silently fails on any bundle past a couple of pages.
INGEST_INLINE_EXTRACTION=false

# Lets the app fire a `repository_dispatch` so the GitHub Actions worker
# (.github/workflows/worker.yml) starts within seconds of an upload instead of
# waiting for that workflow's scheduled backstop run. Both optional: unset =
# quiet no-op (the scheduled run still drains the queue). Set these as Vercel
# environment variables, NOT in this repo. Full setup:
# docs/job-worker-github-actions.md.
#   GITHUB_WORKER_REPO           owner/repo of this repository
#   GITHUB_WORKER_DISPATCH_TOKEN fine-grained PAT for that repo, Contents: RW
# GITHUB_WORKER_REPO=
# GITHUB_WORKER_DISPATCH_TOKEN=

# Bearer token app/api/jobs/tick/route.ts accepts instead of an admin session.
# /api/jobs/tick still exists as a manual/fallback drainer (curl it with this
# token), but no scheduled workflow drives it any more -- .github/workflows/
# worker.yml runs the worker directly instead. Optional: unset -> the route
# falls back to requiring an admin session.
# CRON_SECRET=
