{"nodes": [{"id": "masterplan_doc", "label": "Istifadah Ilmiyah Master Plan v2", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_v1_corrections", "label": "v1 Corrections (six load-bearing claims fixed)", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 claimed every schema decision was cross-checked against real files; six claims failed against the actual export/master.xlsx files and were corrected."}, {"id": "masterplan_department_table", "label": "department table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_admin_head_table", "label": "admin_head table (renamed from head)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_zone_table", "label": "zone table (renamed from venue)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_budget_head_table", "label": "budget_head table (import-derived raw labels)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_cost_center_table", "label": "cost_center table (renamed from budget_category)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_dimension_separation", "label": "Separate, Non-FK-Linked Classification Dimensions Decision", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "admin_head (42 Venue Setup items), budget_head (10 import-derived heads) and cost_center (cross-department Tally-style list) hold completely different data and share only the role of hand-assigned enrichment; kept as separate tables/columns with no FK relationship, ever."}, {"id": "masterplan_vendor_table", "label": "vendor table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_vendor_alias_table", "label": "vendor_alias table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_vendor_resolution_rule", "label": "Vendor Resolution Rule (normalize, match, never auto-merge)", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never fuzzy-auto-merge vendor identities; merging affects payment routing and stays a human decision. Automatic clustering detection cut to week 2; identity capture starts day 2."}, {"id": "masterplan_entry_status_table", "label": "entry_status table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_hub_status_sketch", "label": "hub_status table (pre-merge sketch, superseded)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_entries_table", "label": "entries table (the unified record)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_ubbl_normalization", "label": "ubbl_number Normalization Rule", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "normalizeId() rejects non-finite/decimals, truncates numbers, trims strings, unit-tested against both shapes, so integer vs string UBBL numbers don't break the unique key across import runs."}, {"id": "masterplan_namespace_collision_check", "label": "UBBL/Main-Number Namespace Collision Check", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADP_202608054 appears as both a UBBL Number and a Main Entry Number on different rows; the importer asserts no value exists in both columns and raises a high exception if it does."}, {"id": "masterplan_budget_allocation_table", "label": "budget_allocation table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_import_batch_table", "label": "import_batch table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_import_row_log_table", "label": "import_row_log table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_dryrun_default", "label": "Dry-Run-First Import Pattern", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every import runs dry_run first inside a rolled-back transaction, showing a per-row diff before commit. A finance import that applies blind is a defect, not a feature."}, {"id": "masterplan_upsert_hubowned_exclusion", "label": "Hub-Owned Columns Excluded From Import Upsert", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "admin_head_id/zone_id/cost_center_id/status tracking columns are deliberately absent from the upsert's SET clause so a re-import can never silently revert a staff verification decision."}, {"id": "masterplan_status_export_batch_table", "label": "status_export_batch table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_status_export_row_table", "label": "status_export_row table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_status_export_flow", "label": "Status Export Outward Flow (file-based, permanent, no API)", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only place data flows outward. DESCOPED 2026-08-13: permanently a generated .xlsx applied by hand on the other side; format='api' left in the CHECK constraint but never written, since removing an unused enum value is pure churn."}, {"id": "masterplan_staff_profile_table", "label": "staff_profile table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_handle_new_user_trigger", "label": "handle_new_user() trigger function", "file_type": "code", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_source_document_table", "label": "source_document table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_document_page_table", "label": "document_page table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_ocr_extraction_run_table", "label": "ocr_extraction_run table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_document_extraction_table", "label": "document_extraction table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_document_extraction_line_item_table", "label": "document_extraction_line_item table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_twin_column_pattern", "label": "_ocr/_verified Twin-Column Pattern", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a71, \u00a73.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-destructive by construction: edited fields write only to _verified columns; _ocr is never mutated, preserving both the machine read and the human correction."}, {"id": "masterplan_entry_change_log_table", "label": "entry_change_log table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_audit_trail_rule", "label": "Audit Trail / No-Silent-Overwrite Rule", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 stored only the last writer (updated_by), which is a silent overwrite the original tech spec's audit-trail requirement explicitly forbids; entry_change_log stores every from/to change plus actor and source."}, {"id": "masterplan_reconciliation_exception_table", "label": "reconciliation_exception table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_rate_reference_table", "label": "rate_reference table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_flags_table", "label": "flags table (schema only, week 1)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_job_queue_table", "label": "job_queue table", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_forupdate_skiplocked", "label": "FOR UPDATE SKIP LOCKED Claiming Pattern", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary Postgres, no extension or vendor lock; safe across any number of concurrent workers. Stuck 'running' rows are reclaimed by a sweeper and retried with backoff, then marked dead after max_attempts."}, {"id": "masterplan_job_queue_dual_runner", "label": "Identical Handler Code, Two Callers Pattern", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a73.11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vercel Cron calls /api/jobs/tick today; a Windows Service runs worker/index.ts continuously later. Identical handler code in lib/jobs/handlers/ \u2014 only the caller differs, making server migration a configuration change."}, {"id": "masterplan_rls_helpers", "label": "private schema RLS Helper Functions (is_staff/is_admin/can_see_department)", "file_type": "code", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_rls_policies", "label": "entries Row Level Security Policies", "file_type": "code", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_storage_bucket_policies", "label": "invoice-documents Storage Bucket Policies", "file_type": "code", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_security_invoker_views", "label": "security_invoker Reporting Views Requirement", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Postgres view bypasses RLS by default, running as its creator; security_invoker=true makes it run as the calling user so table RLS policies still apply, preventing cross-department leakage in reports."}, {"id": "masterplan_csp_policy", "label": "Nonce-Based Content Security Policy (proxy.ts/middleware.ts)", "file_type": "code", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.4b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set once in the app, never at the proxy/IIS, because browsers apply the intersection of duplicate CSP headers; nonce-based because 'unsafe-inline' defeats CSP's purpose; requires dynamic rendering."}, {"id": "masterplan_roles_permissions", "label": "Three-Role RBAC (dept/admin/superadmin)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.4c", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_data_retention", "label": "Data Retention Policy", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.4d", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_db_connections", "label": "Database Connection Doors (Data API/direct/pooler)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a74.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_screen_inventory", "label": "Screen Inventory (\u00a75)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_review_queue_design", "label": "Review Queue Keyboard-First Design", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throughput per reviewer is the product's real KPI; queue ordered by open-exception severity, extraction confidence, then amount. Keyboard contract removes mouse dependency for the common path."}, {"id": "masterplan_cost_model", "label": "Cost Model / Anthropic API Budget", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_ocr_pipeline", "label": "OCR Pipeline (upload\u2192ingest\u2192extract\u2192tally\u2192review\u2192re-escalate)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_gold_set", "label": "Gold Set Regression Harness (21 invoices)", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a79.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "90-second deterministic pipeline run against 21 fixed, blind-labelled invoices \u2014 the only way to tell whether a prompt change helped, hurt, or did nothing; catches silent misses a correction log cannot."}, {"id": "masterplan_correction_log", "label": "Correction Log Discovery Mechanism", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a79.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A view over the never-overwritten _ocr/_verified columns surfaces real-world failure classes at scale, but is anchored (reviewers accept wrong pre-filled values more often) and cannot A/B a prompt."}, {"id": "masterplan_improvement_loop", "label": "OCR Improvement Loop (no automatic learning)", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a79.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Corrections accumulate \u2192 /accuracy surfaces patterns \u2192 human edits prompt/schema \u2192 re-run gold set to catch regressions \u2192 deploy. The model is never fine-tuned by corrections."}, {"id": "masterplan_stack_decision", "label": "Tech Stack Decision (Next.js/Supabase/Node worker)", "file_type": "rationale", "source_file": "MASTER-PLAN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route Handlers plus a plain Node worker chosen over Supabase Edge Functions because Deno Edge Functions cannot run on the eventual Windows Server; plain Node runs anywhere."}, {"id": "masterplan_windows_server_cutover", "label": "Windows Server Cutover Plan (Phase 4)", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": "\u00a713, Phase 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "masterplan_doc", "label": "MASTER-PLAN", "file_type": "document", "source_file": "MASTER-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ocrspec_invoices_table", "target": "masterplan_entries_table", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "MASTER-PLAN.md", "source_location": null, "weight": 0.95}, {"source": "ocrspec_vendors_table", "target": "masterplan_vendor_table", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "MASTER-PLAN.md", "source_location": null, "weight": 0.95}, {"source": "ocrspec_flags_table", "target": "masterplan_flags_table", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "MASTER-PLAN.md", "source_location": null, "weight": 0.95}, {"source": "ocrspec_rate_reference_table", "target": "masterplan_rate_reference_table", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "MASTER-PLAN.md", "source_location": null, "weight": 0.95}, {"source": "ocrspec_line_items_table", "target": "masterplan_document_extraction_line_item_table", "