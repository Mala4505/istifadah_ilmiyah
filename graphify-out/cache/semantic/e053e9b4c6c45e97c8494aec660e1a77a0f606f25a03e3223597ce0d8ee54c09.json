{"nodes": [{"id": "ocrdecision_doc", "label": "Where OCR Should Execute \u2014 Decision Doc", "file_type": "document", "source_file": "docs/ocr-execution-decision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ocrdecision_option_a_chunked", "label": "Option A: Chunked Continuation (resumable per-page extraction)", "file_type": "rationale", "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process as many pages as fit the request budget, return a partial result, client requests the next chunk; document_page already records per-page verdicts so 'which pages remain' is a query, not new state."}, {"id": "ocrdecision_option_b_worker", "label": "Option B: Always-On Worker Machine", "file_type": "rationale", "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "worker/index.ts already exists with no timeout; ruled out as primary because the available machine sleeps or gets shut off, and a silently-stopped worker is worse than none."}, {"id": "ocrdecision_option_c_ghactions", "label": "Option C: GitHub Actions As Genuine Executor", "file_type": "rationale", "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigger via repository_dispatch and run extraction inside the runner itself (not curl Vercel); removes the page ceiling via the 6-hour runner limit but a 30-60s cold start fails the instant-start requirement."}, {"id": "ocrdecision_option_d_vercelpro", "label": "Option D: Vercel Pro (raise maxDuration to 300s)", "file_type": "rationale", "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.D", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effectively a one-line change moving the page ceiling from ~30 to ~150 pages for $20/month; moves the ceiling rather than removing it."}, {"id": "ocrdecision_measured_ceiling", "label": "Measured Extraction Time Ceiling (~25-30 pages inline)", "file_type": "rationale", "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real 8-page bundle measured ~15s wall clock at 4-page concurrency; 50 pages extrapolates to ~100s and times out, so the practical inline ceiling is 25-30 pages."}, {"id": "ocrdecision_recommendation", "label": "Staged Recommendation (D now, measure, then A if needed)", "file_type": "rationale", "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Take option D immediately for cheap relief, measure the real maximum bundle size against the new ~150-page ceiling, and only build option A's chunked continuation if that measurement says it is needed."}, {"id": "ocrexecutiondecision_doc", "label": "ocr-execution-decision.md", "file_type": "document", "source_file": "docs/ocr-execution-decision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ocrdecision_doc", "target": "ocrdecision_option_a_chunked", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.A", "weight": 1.0}, {"source": "ocrdecision_doc", "target": "ocrdecision_option_b_worker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.B", "weight": 1.0}, {"source": "ocrdecision_doc", "target": "ocrdecision_option_c_ghactions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.C", "weight": 1.0}, {"source": "ocrdecision_doc", "target": "ocrdecision_option_d_vercelpro", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.D", "weight": 1.0}, {"source": "ocrdecision_doc", "target": "ocrdecision_measured_ceiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "ocrdecision_doc", "target": "ocrdecision_recommendation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "ocrdecision_doc", "target": "eventscoping_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "Companion to event-scoping-and-review-fixes-plan.md", "weight": 1.0}, {"source": "ocrdecision_recommendation", "target": "ocrdecision_option_d_vercelpro", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "ocrdecision_recommendation", "target": "ocrdecision_option_a_chunked", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "ocrdecision_option_b_worker", "target": "masterplan_windows_server_cutover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a72.B - MASTER-PLAN \u00a713 always intended this", "weight": 1.0}, {"source": "ocrdecision_measured_ceiling", "target": "importplan_inline_extraction_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ocr-execution-decision.md", "source_location": "\u00a71", "weight": 1.0}], "hyperedges": [{"id": "ocr_execution_path_resolution", "label": "Resolving Where and How OCR Extraction Executes", "nodes": ["workerworkflow_job", "ocrdecision_doc", "importplan_inline_extraction_decision", "jobworkergha_doc"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/ocr-execution-decision.md"}]}