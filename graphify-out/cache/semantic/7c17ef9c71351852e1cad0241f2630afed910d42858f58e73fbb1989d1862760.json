{"nodes": [{"id": "importplan_doc", "label": "Import & Review UX Plan", "file_type": "document", "source_file": "docs/import-review-ux-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "importplan_d1", "label": "D1: Bill\u2192Entry Attach Writes To A Column Nothing Reads", "file_type": "rationale", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "attachExtractionToEntry writes document_extraction.entry_id but review/page.tsx and v_review_queue read source_document.entry_id, so attach 'succeeds' in the UI and changes nothing observable."}, {"id": "importplan_d2", "label": "D2: Finish The Uncertainty Surface", "file_type": "document", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "importplan_d3", "label": "D3: Bare R Destroys Unsaved Corrections", "file_type": "rationale", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unmodified 'r' keypress runs Sonnet re-extraction with no confirmation or dirty check, remounting the form and silently discarding twenty typed corrections while billing a Sonnet call."}, {"id": "importplan_d4", "label": "D4: Multi-Bill PDF Collapses To One Arbitrary Bill", "file_type": "rationale", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Map keyed by source_document_id keeps only the last document_extraction row per document, so a multi-bill PDF displays and links only one bill in the inbox."}, {"id": "importplan_d5", "label": "D5: Upload Blocks On Backlog; Timeout Reported As Failure", "file_type": "rationale", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ingest route drains unrelated queued jobs after this document's own job before responding, and a platform timeout is reported as upload failure even though extraction likely succeeded."}, {"id": "importplan_d6", "label": "D6: Inbox Re-runs Its Heaviest Query Every 4s", "file_type": "rationale", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "router.refresh() on a 4s interval re-executes six queries including entries capped at 5,000 rows plus candidate ranking, with no loading state to show for it."}, {"id": "importplan_d7", "label": "D7: Import Commit Has No Progress And No Timeout Ceiling", "file_type": "rationale", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "importplan_d8", "label": "D8: No Visible Signal When The Queue Stops Draining", "file_type": "document", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "importplan_c1", "label": "C1: Always-Present Three-State Entry Match Strip", "file_type": "document", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "importplan_z1", "label": "Z1: Zone+Admin-Head As Stage 3 Of Review Flow", "file_type": "document", "source_file": "docs/import-review-ux-plan.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "importplan_z2", "label": "Z2: Zone+Admin-Head At Moment Of Attach", "file_type": "document", 