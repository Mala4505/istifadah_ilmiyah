{"nodes": [{"id": "predeployfindings_doc", "label": "Pre-Deployment Findings & Implementation Plan", "file_type": "document", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "predeployfindings_exceptions_event_scoping_bug", "label": "Exceptions queue hides 33 of 34 open items (0.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event-scoping /exceptions resolves each row's event only through entry_id and drops every row where that is null, discarding all document-level and batch-level exceptions since only one open exception has an entry_id."}, {"id": "predeployfindings_three_screens_disagree", "label": "Three screens disagree by 30x on exception count (0.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboard reads v_open_issues unfiltered by event, Reports reads it filtered by event, Exceptions reads the base table with the 0.1 bug \u2014 three different resolution rules for the same underlying count."}, {"id": "predeployfindings_missing_source_document_id", "label": "reconciliation_exception has no source_document_id (0.3)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten open exceptions reference their document only inside free-text description, so they can never be attributed to an event or surfaced on a document's or entry's page."}, {"id": "predeployfindings_job_queue_never_drained", "label": "Nothing drains the job queue in production (1.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only local-dev-tick/local-dev-upload/e2e-drain workers have ever claimed a job; the GitHub Actions cron's one-time setup steps were never completed, so flags_run never runs and failed extractions never retry."}, {"id": "predeployfindings_staff_department_empty", "label": "staff_department is empty (1.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS is department-based via can_see_department(); with zero staff_department rows and all accounts admin/superadmin, the department-role path (and its RLS) has never been exercised."}, {"id": "predeployfindings_dept_budget_never_imported", "label": "Department budget data never imported (1.4)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "department_budget_allocation is empty and the import workspace's own code comment notes no real spreadsheet has been provided yet, so its column parsing is unverified against a real sheet shape."}, {"id": "predeployfindings_approved_amount_zero", "label": "approved_amount is zero on every budget head (1.5)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Departmental import brings utilised figures but not approved ones; unclear whether the source export lacks approved amounts or the importer drops the column."}, {"id": "predeployfindings_pdf_page_sync_bug", "label": "PDF opens on page 1, never on the bill's own page (2.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pageNumberStart is passed to extraction-form.tsx for a label but never to pdf-viewer.tsx, which hard-codes useState(1); the highest-value fix in the document."}, {"id": "predeployfindings_bill_count_denominator_bug", "label": "'Bill 4 of 3' impossible counter (2.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bill_index is the bill's absolute position but bill_count comes from v_review_queue, which contains only unverified bills, so the denominator drops as bills get verified while numerators stay absolute."}, {"id": "predeployfindings_save_next_bill_bug", "label": "Save advances to queue's next bill, not next bill in this PDF (2.3)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The queue is ordered by severity/confidence/amount by design, so saving bill 1 of PDF-A can land on PDF-B rather than the next unverified sibling bill in the same document."}, {"id": "predeployfindings_documents_inbox_review_tracking_gap", "label": "Documents inbox tracks extraction, not review (3.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once a document reaches 'Extracted' the row stops changing forever regardless of how many of its bills remain unreviewed; the page never queries verified_at at all."}, {"id": "predeployfindings_entry_tally_missing", "label": "Entry page lists bills but never sums them (3.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "linked-documents.tsx renders each bill's own OCR'd total with no sum and no comparison to the entry's imported amount, leaving the tally to be done by eye."}, {"id": "predeployfindings_entry_page_exceptions_missing", "label": "Mismatches never shown on the entry page (3.3)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entry detail page has zero references to reconciliation_exception or flags; all open exceptions live only on the separate /exceptions list."}, {"id": "predeployfindings_document_complete_state_gap", "label": "Nothing anywhere says a PDF is finished (3.4)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No 'complete' state exists in Review or Documents inbox; requires both the Save-recognizes-last-bill fix (2.3) and the verified_at-in-query fix (3.1) to agree on what complete means."}, {"id": "predeployfindings_exception_actionability_gap", "label": "A flag tells you it is wrong, not what to do (4.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolving an exception opens only a free-text note dialog with no destination button routing to the thing that needs changing; proposed a one-line 'what to do' plus a link per exception type."}, {"id": "predeployfindings_exception_labels_incomplete", "label": "Nine exception types have no plain-English label (4.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXCEPTION_TYPE_LABELS covers 14 of 20 database-allowed types; the missing nine render as raw snake_case codes and are also missing from the type filter since EXCEPTION_TYPES derives from the labels map."}, {"id": "predeployfindings_budget_head_drilldown_gap", "label": "Department to budget head to expense drilldown doesn't connect (5.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Budget heads render as one flat list across all departments with no department column and no link out, unlike department/vendor/zone rows which all link to a filtered Entries list."}, {"id": "predeployfindings_vendor_sections_overlap", "label": "Two vendor sections overlap (5.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendor spend and vendor concentration rank the same vendors by the same spend with the same bar chart, differing only in trailing columns; proposed folding into one table."}, {"id": "predeployfindings_cost_center_missing", "label": "Cost centres appear nowhere in Reports, none assigned (5.4)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The middle rung of the department-cost_center-budget_head hierarchy the user described is missing entirely; the plumbing exists (a cost_center table, a filter, a picker) but nothing has ever been assigned."}, {"id": "predeployfindings_event_scoping_missed_surfaces", "label": "Four surfaces missed event scoping (6.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboard, v_entry_status_counts, the analytics views, and /import batch history all lack event_id; invisible today because only one event exists, but the Dashboard will start lying the day a second event is created."}, {"id": "predeployfindings_event_switcher_deleted", "label": "No way to switch events (6.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A prior commit deleted event-switcher.tsx and setActiveEvent, so the active_event_id cookie is now written by nothing, making read-only past-event browsing unreachable."}, {"id": "predeployfindings_ocr_meta_commentary_leak", "label": "Model commentary landing in a data field (10.1)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bank cheque page's notes field contained prose about the document instead of content from it, and vendor was misread as the bank rather than the actual supplier, the same class of problem as the existing leaked-tag-syntax guard."}, {"id": "predeployfindings_prompt_cache_cliff", "label": "Prompt-cache fix sits 57 tokens from a silent cliff (10.2)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Haiku 4.5's 4,096-token minimum cacheable prefix was measured at ~4,039 tokens, 57 short; prompts under the floor process without caching and without error, so a future prompt trim silently stops caching with nothing to notice."}, {"id": "predeployfindings_id_document_skip_reason_gap", "label": "No skip_reason for an ID document like a PAN card (10.3)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skip_reason check constraint has no id_document value, so PAN/Aadhaar pages fall into the ambiguous 'other' bucket, indistinguishable from a genuinely unclassifiable page."}, {"id": "predeployfindings_page_ceiling_decision", "label": "20-page upload ceiling, needs a resumable-extraction decision", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 8 pages ~15s, 20 ~39s, 28 ~54s against a 60s limit; raising the cap needs either a longer request budget or resumable extraction, deferred pending the largest realistic weekly upload."}, {"id": "predeployfindings_department_budget_feature", "label": "Department-level budget vs. actual (feature concept)", "file_type": "rationale", "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate, department-granularity budget dataset (not a rollup of per-budget-head allocations) hand-imported from Excel and compared against event actuals; specified fully in review-page-layout-redesign-plan.md \u00a711."}], "edges": [{"source": "predeployfindings_doc", "target": "hubrefinementsplan_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "weight": 1.0}, {"source": "predeployfindings_doc", "target": "masterplan_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pre-deploy-findings-and-plan.md", "source_location": null, "weight": 1.0}, {"source": "predeployfindings_doc", "target": "predeployfindings_exce