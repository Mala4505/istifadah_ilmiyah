{"nodes": [{"id": "permremediation_doc", "label": "Speed, Efficiency & UX Remediation \u2014 Execution Plan", "file_type": "document", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "permremediation_root_cause_a", "label": "Root cause A: unindexable OR lateral join in v_review_queue", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres cannot flatten a correlated OR across two columns, so the exception scan re-plans per outer row against indexes not scoped to status='open' \u2014 the dominant cost on every /review load."}, {"id": "permremediation_root_cause_b", "label": "Root cause B: whole-ledger fuzzy matching in request path", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to 5,000 entries rows fetched and ranked in JS on every unmatched-bill open, causing silent truncation of older entries and RLS multiplier cost."}, {"id": "permremediation_root_cause_c", "label": "Root cause C: getSelectedEventId never memoized", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every call site re-issued two round trips (cookie validate + row fetch); nine call sites on /reports alone."}, {"id": "permremediation_review_queue_rewrite", "label": "v_review_queue CTE rewrite (migration 20260904000001)", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the correlated lateral OR with two pre-aggregated, UNION'd CTEs to avoid double-counting a reconciliation_exception row that carries both entry_id and document_extraction_id, discovered as a real reachable bug via flagReviewException."}, {"id": "permremediation_match_candidate_rpc", "label": "match_candidate_entries server-side RPC", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SECURITY INVOKER function pre-filtering by vendor, amount proximity, normalized invoice number and vendor-name trigram similarity before ranking, replacing an unbounded 5,000-row entries fetch and its silent-truncation correctness bug; a LIMIT 300 exists only as a last-resort safety valve, not the primary bound."}, {"id": "permremediation_event_id_threading", "label": "Threading eventId through reports loaders", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids each loader re-reading the cookie once the page already resolved the event; cheaper to fix before more unimported loaders replicate the pattern."}, {"id": "permremediation_superadmin_lockout_guard", "label": "Superadmin self-lockout guard", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks a superadmin from demoting or deactivating their own account without explicit confirmation, enforced both client-side (Dialog confirmation) and server-side in updateStaffProfile."}, {"id": "permremediation_middleware_matcher_fix", "label": "Middleware matcher excludes pdf.worker.min.mjs / bookmarklet", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opening a bill previously triggered a full middleware run (CSP nonce + auth.getUser()) just to serve a static worker script, in the review flow's most latency-sensitive moment."}, {"id": "permremediation_ingest_inline_extraction_flag", "label": "INGEST_INLINE_EXTRACTION flag and Hobby-tier maxDuration exposure", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vercel Hobby hard-caps execution at 10s while inline synchronous extraction could run ~15s+, causing silent data loss; flipping the flag to false moved to a poll-based upload path already built (app/api/documents/status/route.ts)."}, {"id": "permremediation_worker_github_actions", "label": "GitHub Actions worker job drain (worker.yml)", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cron-tick.yml's /api/jobs/tick ran the same extraction handler under the same 10s Hobby kill, so it was never a working safety net; the fix runs worker/index.ts directly as a GitHub Actions job with no Vercel function and a repository_dispatch trigger fired within seconds of work being queued."}, {"id": "permremediation_review_rerender_fix", "label": "Review workspace re-render elimination (Phase 5)", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitting one large header-form useState object into per-field slices, memoizing heavy children, fixing an O(n^2) diff, replacing a JSON.stringify dirty check, and keying the PDF viewer on sourceDocumentId instead of documentExtractionId so sibling-bill navigation no longer remounts pdf.js."}, {"id": "permremediation_reports_suspense_streaming", "label": "Reports Suspense streaming restructuring (Phase 6.1)", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits each surface's sections into small async Server Components behind their own Suspense boundary so hero metrics paint before the slowest section resolves, rather than one page-wide Promise.all gating all JSX."}, {"id": "permremediation_board_pack_polling", "label": "Board pack status polling", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side polling with backoff chosen over revalidatePath/revalidateTag because the board-pack job can be driven by a standalone Node worker with no Next request context, where server-side revalidation would silently no-op."}, {"id": "permremediation_vendor_merge_confirmation", "label": "Vendor merge confirmation step", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging previously happened immediately on target selection with no confirmation despite re-attributing spend and document history; added a confirm step modeled on the Dialog-confirmation convention from the superadmin self-lockout guard."}, {"id": "permremediation_asymmetric_jwt_deferred", "label": "Asymmetric JWT verification (deferred lever)", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Would remove one to two real network hops from every request via getClaims() instead of auth.getUser() calling the Auth server, but requires enabling asymmetric signing keys, a project-level and possibly plan-gated decision, so deliberately not done."}, {"id": "permremediation_exceptions_dedup_fetch", "label": "Merged exceptions queue + severity-counts fetch (Phase 4.3)", "file_type": "rationale", "source_file": "docs/performance-remediation-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the queue's own bucketed fetch as the severity chips' source only when it is provably the full open population, falling back to a separate fetch otherwise, while resolveEventIds always runs once per request regardless of which branch is taken."}], "edges": [{"source": "permremediation_doc", "target": "perfuxaudit_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/performance-remediation-plan.md", "source_location": null, "weight": 1.0}, {"source": "permremediation_doc", "target": "predeployfindings_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/performance-remediation-plan.md", "source_location": null, "weight": 1.0}, {"source": "permremediation_doc", "target": "hubscreencertification_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/performance-remediation-plan.md", "source_location": null, "weight": 1.0}, {"source": "permremediation_doc", "target": "ocrexecutiondecision_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/performance-remediation-plan.md", "source_location": null, "weight": 1.0}, {"source": "permremediation_doc", "target": "jobworkergithubactions_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/performance-remediation-plan.md", "source_location": null, "weight": 1.0}, {"source": "permre