{"nodes": [{"id": "hubcert_doc", "label": "Hub Screen Certification \u2014 Audit & Remediation Plan", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_rubric", "label": "Seven-Dimension Certification Rubric", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_wave1", "label": "Wave 1: Stop The Screens Misreporting", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_wave2", "label": "Wave 2: Make The Reviewer Fast", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_wave3", "label": "Wave 3: The Missing Table Affordances", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_wave4", "label": "Wave 4: Accessibility And Finish", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_review_tiebreaker_bug", "label": "Review Queue Nondeterministic Order Bug (1.1)", "file_type": "rationale", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73.1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The queue sorts on severity, confidence, amount and stops with no final tiebreaker, so ties (the common case) return in arbitrary Postgres order, making bill position and LIMIT 500 unstable."}, {"id": "hubcert_exceptions_unordered_bug", "label": "Exceptions Queue Unordered/Unlimited Fetch Bug (1.2)", "file_type": "rationale", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73.1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorting happens client-side after an unordered, unlimited fetch, so PostgREST's default cap can silently truncate high-severity exceptions on an audit tool \u2014 the worst available failure mode."}, {"id": "hubcert_documents_unbounded_query", "label": "Documents Unbounded Query Bug (1.3)", "file_type": "rationale", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73.1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_vendor_search_paren_bug", "label": "Vendor Search Parentheses 400 Bug (1.4)", "file_type": "rationale", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73.1.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgREST reserves parentheses as or() group delimiters; a vendor name like 'Acme (India)' closes the filter group early and 400s, though such names are ordinary in Indian vendor data."}, {"id": "hubcert_claim_race_bug", "label": "Review Claim Race/Never-Released/Never-Enforced Bug (1.8)", "file_type": "rationale", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73.1.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claim is a read-then-write race, never released on leave, never refreshed on multi-bill navigation, and never checked by saveVerification, so two reviewers can both save the same bill with last-write-wins."}, {"id": "hubcert_shared_pagination_component", "label": "Shared Pagination Bar (3.1)", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a75.3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_shared_sortable_header", "label": "Shared Sortable Table Header (3.2)", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a75.3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hubcert_status_colour_unification", "label": "Unified Status Colour Map (3.3)", "file_type": "rationale", "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a75.3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Pending' renders grey on Entries via label-sniffing but amber on the Dashboard via a code-first map; the two should be unified into one shared lib/status-badge.ts."}, {"id": "hubscreencertification_doc", "label": "hub-screen-certification.md", "file_type": "document", "source_file": "docs/hub-screen-certification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "hubcert_doc", "target": "hubcert_rubric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "hubcert_doc", "target": "hubcert_wave1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "hubcert_doc", "target": "hubcert_wave2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/hub-screen-certification.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "hubcert_doc", "target": "hubcert_wave3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/hub-screen-certification.md", "